# Normalize line endings across contributors and CI
* text=auto eol=lf

*.sh text eol=lf
*.desktop text eol=lf
*.conf text eol=lf
*.in text eol=lf
*.toml text eol=lf
*.example text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
CMakeLists.txt text eol=lf
debian/rules text eol=lf
debian/control text eol=lf
debian/changelog text eol=lf
debian/copyright text eol=lf

*.png binary
*.svg binary
*.ico binary
*.deb binary
*.gz binary
*.gguf binary
*.db binary
*.sqlite binary
